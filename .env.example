# Copiez ce fichier en ".env" en local (jamais commité, voir .gitignore)
# En production (GitHub Actions), ces valeurs sont dans Settings > Secrets and variables > Actions

# Clé API OpenWeatherMap (https://openweathermap.org/api/air-pollution)
OWM_API_KEY=votre_cle_ici

# Chaîne de connexion Postgres (Supabase : Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres
